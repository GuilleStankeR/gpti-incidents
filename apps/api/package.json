{
  "name": "@incidents/api",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for incident management",
  "scripts": {
    "dev": "dotenv -e ../../.env -- nest start --watch",
    "build": "prisma generate && nest build",
    "start": "dotenv -e ../../.env -- node dist/main.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "db:seed": "dotenv -e ../../.env -- prisma db seed",
    "db:reset": "dotenv -e ../../.env -- prisma migrate reset --force",
    "db:studio": "dotenv -e ../../.env -- prisma studio"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "dotenv-cli": "11.0.0",
    "prisma": "5.22.0",
    "tsx": "4.23.15"
  },
  "dependencies": {
    "@incidents/shared": "1.0.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  }
}
