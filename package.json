{
  "name": "gpti-incidents",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Gestión y Reporte de Incidentes de Seguridad y Mantenimiento",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/ensure-env.mjs && node scripts/ensure-docker.mjs && npm install && npm run build -w @incidents/shared && npm run db:up && npm run db:generate -w @incidents/api && npm run db:migrate -w @incidents/api && npm run db:seed -w @incidents/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "dev": "npm run build -w @incidents/shared && concurrently -n api,web -c blue,green \"npm run dev -w @incidents/api\" \"npm run dev -w @incidents/web\"",
    "start": "npm run setup && npm run dev",
    "db:reset": "npm run db:reset -w @incidents/api"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "concurrently": "10.0.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-unicorn": "62.0.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "allowScripts": {
    "unrs-resolver": false,
    "fsevents": false,
    "@nestjs/core": false,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true,
    "@prisma/client": false,
    "esbuild": false
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --max-warnings 0 --no-warn-ignored"
    ],
    "*.{json,css,html,yml,yaml}": "prettier --write"
  },
  "overrides": {
    "rxjs": "7.8.2"
  }
}
